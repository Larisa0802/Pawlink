<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Animales - PawLink</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

    body {
      font-family: 'Nunito', sans-serif;
    }

    .tarjetaAnimal {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .tarjetaAnimal:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    #editModal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 50;
    }

    .modalContent {
      background: white;
      border-radius: 1rem;
      padding: 2rem;
      max-width: 480px;
      width: 90%;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }
  </style>
</head>

<body class="min-h-screen bg-amber-50">

  <%- include("../partials/sidebar") %>

    <main class="ml-64 p-10 min-h-screen">

      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-amber-800 tracking-tight">🐾 Animales en adopción</h1>
        <p class="text-amber-600 mt-1 text-sm">Encuentra a tu compañero perfecto</p>
      </div>

      <% if (animales && animales.length> 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% animales.forEach((animal)=> { %>
            <div class="tarjetaAnimal bg-white rounded-2xl shadow-md overflow-hidden flex flex-col">

              <div class="w-full h-44 bg-amber-100 flex items-center justify-center overflow-hidden">
                <% if (animal.foto) { %>
                  <img src="<%= animal.foto %>" alt="<%= animal.nombre %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <span class="text-5xl">🐶</span>
                    <% } %>
              </div>

              <div class="p-4 flex flex-col flex-1">
                <h2 class="text-lg font-bold text-gray-800 mb-2">
                  <%= animal.nombre %>
                </h2>

                <div class="text-sm text-gray-500 space-y-1 flex-1">
                  <p><span class="font-semibold text-gray-600">Raza:</span>
                    <%= animal.raza || '—' %>
                  </p>
                  <p>
                    <span class="font-semibold text-gray-600">Género:</span>
                    <% if (animal.sexo==='macho' || animal.sexo==='Macho' ) { %>
                      <span class="text-blue-500 font-semibold">♂ Macho</span>
                      <% } else if (animal.sexo==='hembra' || animal.sexo==='Hembra' ) { %>
                        <span class="text-pink-500 font-semibold">♀ Hembra</span>
                        <% } else { %>
                          <%= animal.sexo || '—' %>
                            <% } %>
                  </p>
                  <p><span class="font-semibold text-gray-600">Nacimiento:</span>
                    <%= new Date(animal.fecha_nacimiento).toLocaleDateString("es-ES") %>
                  </p>
                </div>

                <%# Guardamos todos los datos del animal en data-attributes %>
                  <button
                    class="masInfo1 mt-4 w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors duration-150"
                    data-nombre="<%= animal.nombre %>" data-chip="<%= animal.chip || '—' %>"
                    data-especie="<%= animal.especie || '—' %>" data-raza="<%= animal.raza || '—' %>"
                    data-sexo="<%= animal.sexo || '—' %>"
                    data-nacimiento="<%= new Date(animal.fecha_nacimiento).toLocaleDateString('es-ES') || '—' %>"
                    data-pelaje="<%= animal.pelaje || '—' %>" data-vacunas="<%= animal.vacunas || '—' %>"
                    data-esterilizado="<%= animal.esterilizado ? 'Sí' : 'No' %>"
                    data-desparasitado="<%= animal.desparasitado ? 'Sí' : 'No' %>" data-foto="<%= animal.foto || '' %>">
                    Más información
                  </button>
              </div>

            </div>
            <% }) %>
        </div>

        <% } else { %>
          <div class="flex flex-col items-center justify-center py-24 text-center text-amber-700">
            <span class="text-6xl mb-4">🐾</span>
            <p class="text-xl font-bold">No hay animales disponibles</p>
            <p class="text-sm mt-1 text-amber-500">Vuelve a intentarlo más tarde</p>
          </div>
          <% } %>

    </main>

    <!-- Modal (vacío, se rellena con JS) -->
    <div id="editModal" style="display: none;">
      <div class="modalContent">

        <div class="flex items-center justify-between mb-5">
          <h2 id="modal-nombre" class="text-2xl font-extrabold text-gray-800"></h2>
          <button id="cerrarModal"
            class="text-gray-400 hover:text-gray-600 text-3xl font-bold leading-none">&times;</button>
        </div>

        <div id="modal-foto-wrap" class="mb-5 hidden">
          <img id="modal-foto" src="" alt="" class="w-full h-52 object-cover rounded-xl">
        </div>

        <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm text-gray-700">
          <p><span class="font-semibold text-gray-500 block">Chip</span><span id="modal-chip"></span></p>
          <p><span class="font-semibold text-gray-500 block">Especie</span><span id="modal-especie"></span></p>
          <p><span class="font-semibold text-gray-500 block">Raza</span><span id="modal-raza"></span></p>
          <p><span class="font-semibold text-gray-500 block">Sexo</span><span id="modal-sexo"></span></p>
          <p><span class="font-semibold text-gray-500 block">Fecha nacimiento</span><span id="modal-nacimiento"></span>
          </p>
          <p><span class="font-semibold text-gray-500 block">Pelaje</span><span id="modal-pelaje"></span></p>
          <p><span class="font-semibold text-gray-500 block">Vacunas</span><span id="modal-vacunas"></span></p>
          <p><span class="font-semibold text-gray-500 block">Esterilizado</span><span id="modal-esterilizado"></span>
          </p>
          <p><span class="font-semibold text-gray-500 block">Desparasitado</span><span id="modal-desparasitado"></span>
          </p>
        </div>
        <button
          class="masInfo1 mt-4 w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors duration-150">Adoptar</button>
      </div>
    </div>

    <script>
      const modal = document.getElementById('editModal');

      // Rellenar y abrir modal con los datos del botón pulsado
      document.querySelectorAll('.masInfo1').forEach(btn => {
        btn.addEventListener('click', () => {
          const d = btn.dataset;

          document.getElementById('modal-nombre').textContent = d.nombre;
          document.getElementById('modal-chip').textContent = d.chip;
          document.getElementById('modal-especie').textContent = d.especie;
          document.getElementById('modal-raza').textContent = d.raza;
          document.getElementById('modal-sexo').textContent = d.sexo;
          document.getElementById('modal-nacimiento').textContent = d.nacimiento;
          document.getElementById('modal-pelaje').textContent = d.pelaje;
          document.getElementById('modal-vacunas').textContent = d.vacunas;
          document.getElementById('modal-esterilizado').textContent = d.esterilizado;
          document.getElementById('modal-desparasitado').textContent = d.desparasitado;

          // Foto opcional
          const fotoWrap = document.getElementById('modal-foto-wrap');
          const fotoImg = document.getElementById('modal-foto');
          if (d.foto) {
            fotoImg.src = d.foto;
            fotoImg.alt = d.nombre;
            fotoWrap.classList.remove('hidden');
          } else {
            fotoWrap.classList.add('hidden');
          }

          modal.style.display = 'flex';
        });
      });

      // Cerrar con el botón ✕
      document.getElementById('cerrarModal').addEventListener('click', () => {
        modal.style.display = 'none';
      });

      // Cerrar al hacer clic en el fondo
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.style.display = 'none';
      });
    </script>

</body>

</html>