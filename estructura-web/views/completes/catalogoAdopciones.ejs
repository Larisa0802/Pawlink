<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <title>Animales - PawLink</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

    body {
      font-family: 'Nunito', sans-serif;
    }

    .tarjetaAnimal {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .tarjetaAnimal:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    #editModal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 50;
    }

    /*.modalContent {
      background: white;
      border-radius: 1rem;
      padding: 2rem;
      max-width: 480px;
      width: 90%;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }*/
  </style>
</head>

<body class="min-h-screen bg-amber-50">

  <%- include("../partials/sidebar") %>

    <main class="md:ml-64 pt-16 md:pt-8 p-8 flex-grow bg-[#DDECF6] min-h-screen">
      <nav class="text-sm font-semibold text-gray-400 mb-2">
        <span id="breadcrumb">Cargando ruta...</span>
      </nav>

      <div class="bg-white rounded-2xl shadow-sm p-8 border-l-8 border-[#E5531C] mb-8">
        <h1 class="text-3xl font-extrabold text-black">🐾 Animales en adopción</h1>
        <p class="text-gray-600 mt-2 text-lg">Encuentra a tu compañero perfecto</p>
      </div>

      <% if (error) { %>
      <div class="bg-red-50 border border-red-300 text-red-700 rounded-xl px-5 py-3 mb-4 flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
      <% } %>
      <div class="flex flex-row gap-2 rounded-2xl p-2 mb-4">
        <input id="entrada" placeholder="Buscar compañero por raza..." style="border-radius: 1rem;"
          class="bg-white border h-10 w-2/3 border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#E5531C]">
        <div class="flex flex-row w-1/3 gap-2 rounded-xl p-2 mb-4">
          <input type="radio" id="sexo-hembra" name="filtroSexo" value="hembra">
          <label for="sexo-hembra">Hembra</label>
          <input type="radio" id="sexo-macho" name="filtroSexo" value="macho">
          <label for="sexo-macho">Macho</label>
          <input type="radio" id="sexo-todos" name="filtroSexo" value="todos" checked>
          <label for="sexo-todos">Todos</label>
        </div>
      </div>

      <% if (animales && animales.length> 0) { %>
        <div id="contenedor-animales" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% animales.forEach((animal)=> { %>
            <div class="tarjetaAnimal bg-white rounded-2xl shadow-md overflow-hidden flex flex-col">
              <div class="relative w-full h-44 bg-amber-100 flex items-center justify-center overflow-hidden">
                <% if (animal._foto) { %>
                  <img src="<%= animal._foto %>" alt="<%= animal._nombre %>"
                    class="w-full h-full object-cover <%= !animal._disponible ? 'brightness-50' : '' %>">

                  <% if (!animal._disponible) { %>
                    <div
                      class="absolute top-3 right-3 bg-red-600 text-white text-[10px] font-extrabold px-2 py-1 rounded-md uppercase tracking-tighter shadow-xl border border-red-500">
                      No disponible
                    </div>
                    <% } %>

                      <% } else { %>
                        <span class="text-5xl <%= !animal._disponible ? 'opacity-30' : '' %>">🐶</span>
                        <% if (!animal._disponible == 0) { %>
                          <div
                            class="absolute top-3 right-3 bg-red-600 text-white text-[10px] font-extrabold px-2 py-1 rounded-md uppercase tracking-tighter shadow-xl">
                            No disponible
                          </div>
                          <% } %>
                            <% } %>
              </div>

              <div class="p-4 flex flex-col flex-1">
                <h2 class="text-lg font-bold text-gray-800 mb-2">
                  <%= animal._nombre %>
                </h2>

                <div class="text-sm text-gray-500 space-y-1 flex-1">
                  <p><span class="font-semibold text-gray-600">Raza:</span>
                    <%= animal._raza || '—' %>
                  </p>
                  <p>
                    <span class="font-semibold text-gray-600">Género:</span>
                    <% if (animal._sexo==='macho' || animal._sexo==='Macho' ) { %>
                      <span class="text-blue-500 font-semibold">♂ Macho</span>
                      <% } else if (animal._sexo==='hembra' || animal._sexo==='Hembra' ) { %>
                        <span class="text-pink-500 font-semibold">♀ Hembra</span>
                        <% } else { %>
                          <%= animal._sexo || '—' %>
                            <% } %>
                  </p>
                  <p><span class="font-semibold text-gray-600">Nacimiento:</span>
                    <%= new Date(animal._fecha_nacimiento).toLocaleDateString("es-ES") %>
                  </p>
                </div>

                <%# Guardamos todos los datos del animal en data-attributes %>
                  <button
                    class="masInfo1 mt-4 w-full bg-[#E5531C] text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors duration-150"
                    data-id="<%= animal._id %>"
                    data-nombre="<%= animal._nombre %>" data-chip="<%= animal._chip || '—' %>"
                    data-especie="<%= animal._especie || '—' %>" data-raza="<%= animal._raza || '—' %>"
                    data-sexo="<%= animal._sexo || '—' %>"
                    data-nacimiento="<%= new Date(animal._fecha_nacimiento).toLocaleDateString('es-ES') || '—' %>"
                    data-pelaje="<%= animal._pelaje || '—' %>" data-vacunas="<%= animal._vacunas || '—' %>"
                    data-esterilizado="<%= animal._esterilizado ? 'Sí' : 'No' %>"
                    data-desparasitado="<%= animal._desparasitado ? 'Sí' : 'No' %>"
                    data-foto="<%= animal._foto || '' %>">
                    Más información
                  </button>
              </div>

            </div>
            <% }) %>
        </div>
        <div id="paginacion-catalogo" class="mt-12 flex justify-center"></div>
    </main>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-24 text-center text-amber-700">
          <span class="text-6xl mb-4">🐾</span>
          <p class="text-xl font-bold">No hay animales disponibles</p>
          <p class="text-sm mt-1 text-amber-500">Vuelve a intentarlo más tarde</p>
        </div>
        <% } %>

    </main>

    <!--Modal masinformacion -->
    <div id="editModal" style="display: none;">
      <div
        class="relative bg-white rounded-3xl shadow-2xl flex flex-row w-[90%] max-w-5xl overflow-hidden min-h-[450px]">
        <div id="modal-foto-wrap"
          class="w-1/3 bg-gray-100 flex items-center justify-center overflow-hidden border-r border-gray-100">
          <img id="modal-foto" src="" alt="" class="w-full h-full object-cover">
        </div>

              <div class="flex-1 p-10 flex flex-col justify-center">
                <h2 id="modal-nombre" class="text-4xl font-extrabold text-gray-800 mb-8 pb-2 inline-block"></h2>

                <div class="grid grid-cols-2 gap-x-8 gap-y-5 text-gray-700">
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Chip</span><span
                      id="modal-chip" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Especie</span><span
                      id="modal-especie" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Raza</span><span
                      id="modal-raza" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Sexo</span><span
                      id="modal-sexo" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Nacimiento</span><span
                      id="modal-nacimiento" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Pelaje</span><span
                      id="modal-pelaje" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Vacunas</span><span
                      id="modal-vacunas" class="flex flex-col gap-1 max-h-24  mt-1 text-lg font-semibold text-gray-800">
                    </span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Esterilizado</span><span
                      id="modal-esterilizado" class="text-lg font-semibold text-gray-800"></span></div>
                  <div><span class="text-[10px] uppercase font-bold text-gray-400 block">Desparasitado</span><span
                      id="modal-desparasitado" class="text-lg font-semibold text-gray-800"></span></div>
                </div>
              </div>


        <div class="w-48 p-6 flex flex-col justify-between items-end">
          <button id="cerrarModal"
            class="text-gray-400 hover:text-gray-600 text-4xl font-light transition-transform hover:scale-110 cursor-pointer">&times;</button>

          <div class="flex-1 flex items-center">
            <button
              id="btnAdoptar"
              type="button"
              class="bg-[#E5531C] text-white font-bold mr-[70px] py-4 px-8 rounded-2xl text-l shadow-lg hover:bg-[#d44819] transition-all hover:-translate-y-1 active:scale-95 whitespace-nowrap">
              Adoptar
            </button>
          </div>
          <div class="h-10"></div>
        </div>
      </div>
    </div>
    </div>

<!-- Hidden form for adoption POST -->
    <form id="adoptarForm" method="POST" action="/adoptar" style="display:none;">
      <input type="hidden" id="adoptarAnimalId" name="animal_id">
    </form>

    <%- include("../partials/footer") %>

      <script>
        const modal = document.getElementById('editModal');
        let modalAnimalId = null;
        // Rellenar y abrir modal con los datos del botón pulsado
        document.querySelectorAll('.masInfo1').forEach(btn => {
          btn.addEventListener('click', () => {
            const d = btn.dataset;
            modalAnimalId = d.id;

                document.getElementById('modal-nombre').textContent = d.nombre;
                document.getElementById('modal-chip').textContent = d.chip;
                document.getElementById('modal-especie').textContent = d.especie;
                document.getElementById('modal-raza').textContent = d.raza;
                document.getElementById('modal-sexo').textContent = d.sexo;
                document.getElementById('modal-nacimiento').textContent = d.nacimiento;
                document.getElementById('modal-pelaje').textContent = d.pelaje;
                const vacunasEl = document.getElementById('modal-vacunas');
                vacunasEl.innerHTML = '';
                if (d.vacunas && d.vacunas !== '—') {
                  d.vacunas.split(';').map(v => v.trim()).filter(Boolean).forEach(v => {
                    const s = document.createElement('span');
                    s.textContent = '• ' + v;
                    vacunasEl.appendChild(s);
                  });
                } else {
                  vacunasEl.textContent = '—';
                }
                document.getElementById('modal-esterilizado').textContent = d.esterilizado;
                document.getElementById('modal-desparasitado').textContent = d.desparasitado;

                // Foto opcional
                const fotoWrap = document.getElementById('modal-foto-wrap');
                const fotoImg = document.getElementById('modal-foto');
                if (d.foto) {
                  fotoImg.src = d.foto;
                  fotoImg.alt = d.nombre;
                  fotoWrap.classList.remove('hidden');
                } else {
                  fotoWrap.classList.add('hidden');
                }

            modal.style.display = 'flex';
          });
        });
            // Botón Adoptar
          document.getElementById('btnAdoptar').addEventListener('click', () => {
            if (!modalAnimalId) return;
            document.getElementById('adoptarAnimalId').value = modalAnimalId;
            document.getElementById('adoptarForm').submit();
          });

            // Cerrar con el botón ✕
            document.getElementById('cerrarModal').addEventListener('click', () => {
              modal.style.display = 'none';
            });

            // Cerrar al hacer clic en el fondo
            modal.addEventListener('click', (e) => {
              if (e.target === modal) modal.style.display = 'none';
            });

            //conseguir el historial guardado o crear uno nuevo
            let pathHistory = JSON.parse(sessionStorage.getItem('userPath')) || [];

            const rutaActual = window.location.pathname + window.location.search;

            if (pathHistory.length === 0 || pathHistory[pathHistory.length - 1] !== rutaActual) {
              pathHistory.push(rutaActual);
              sessionStorage.setItem('userPath', JSON.stringify(pathHistory));
            }


            const displayPath = pathHistory.map(ruta => {
              if (ruta === '/' || ruta.includes('index')) return '🏠 Inicio';
              if (ruta.includes('vistaEleccion')) return 'Elección';
              if (ruta.includes('adopciones')) return 'Catálogo';
              return ruta.replace('/', '');
            }).join('  /  ');

            //meterlo en la vista
            document.getElementById('breadcrumb').innerText = displayPath;

            //filtro de búsqueda y radio
            function aplicarFiltros() {
              //1 - leer el valor de input
              const queryRaza = document.getElementById("entrada").value.toLowerCase().trim();

              //2 - leer el valor de los radio button
              const sexoSeleccionado = document.querySelector("input[name='filtroSexo']:checked").value;

              // 3 - recorrer cada tarjeta y decidir si mostrarla u ocultarla
              document.querySelectorAll(".tarjetaAnimal").forEach(function (card) {
                const btn = card.querySelector("[data-raza]");
                const raza = (btn ? btn.dataset.raza : "").toLowerCase();
                const sexo = (btn ? btn.dataset.sexo : "").toLowerCase();

                const coincideRaza = raza.includes(queryRaza);
                const coincideSexo = sexoSeleccionado === "todos" || sexo === sexoSeleccionado;

                // En lugar de ocultar directamente, marcamos si cumple el filtro
                if (coincideRaza && coincideSexo) {
                  card.setAttribute("data-visible", "true");
                } else {
                  card.setAttribute("data-visible", "false");
                  card.style.display = "none";
                }
              });

              // Reiniciar a la página 1 tras filtrar
              paginaActual = 1;
              renderPagina();
            }

            // --- LÓGICA DE PAGINACIÓN ---
            const ITEMS_POR_PAGINA = 20;
            let paginaActual = 1;

            function renderPagina() {
              const contenedor = document.getElementById("contenedor-animales");
              if (!contenedor) return;

              const todasLasTarjetas = Array.from(contenedor.querySelectorAll(".tarjetaAnimal"));
              const tarjetasFiltradas = todasLasTarjetas.filter(card => card.getAttribute("data-visible") !== "false");

              const totalItems = tarjetasFiltradas.length;
              const totalPaginas = Math.ceil(totalItems / ITEMS_POR_PAGINA);

              // Ocultar todas primero
              todasLasTarjetas.forEach(card => card.style.display = "none");

              // Mostrar solo las de la página actual
              const inicio = (paginaActual - 1) * ITEMS_POR_PAGINA;
              const fin = inicio + ITEMS_POR_PAGINA;

              tarjetasFiltradas.slice(inicio, fin).forEach(card => {
                card.style.display = "flex";
              });

              renderControles(totalPaginas, totalItems);
            }

            function renderControles(totalPaginas, totalItems) {
              const container = document.getElementById("paginacion-catalogo");
              if (!container) return;

              if (totalPaginas <= 1) {
                container.innerHTML = "";
                return;
              }

              let botonesHTML = "";
              for (let i = 1; i <= totalPaginas; i++) {
                const activo = i === paginaActual
                  ? "bg-[#E5531C] text-white"
                  : "bg-white text-gray-700 hover:bg-gray-100";
                botonesHTML += `
              <button onclick="irAPagina(${i})" class="w-10 h-10 mx-1 rounded-xl border font-bold transition ${activo}">
                ${i}
              </button>`;
              }

              container.innerHTML = `
            <div class="flex items-center gap-2">
              <button onclick="irAPagina(${paginaActual - 1})" ${paginaActual === 1 ? 'disabled' : ''} 
                class="w-10 h-10 rounded-xl border bg-white flex items-center justify-center disabled:opacity-30">
                <i class="fa-solid fa-chevron-left"></i>
              </button>
              ${botonesHTML}
              <button onclick="irAPagina(${paginaActual + 1})" ${paginaActual === totalPaginas ? 'disabled' : ''} 
                class="w-10 h-10 rounded-xl border bg-white flex items-center justify-center disabled:opacity-30">
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            </div>
          `;
            }

            function irAPagina(n) {
              paginaActual = n;
              renderPagina();
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Inicializar la primera vista
            document.addEventListener("DOMContentLoaded", () => {
              aplicarFiltros();
            });

            // llamar a aplicarFiltros() cada vez que se escribe en el input
            document.getElementById("entrada").addEventListener("input", aplicarFiltros);

            // llamar a aplicarFiltros() cada vez que se cambia el radio
            document.querySelectorAll("input[name='filtroSexo']").forEach(function (radio) {
              radio.addEventListener("change", aplicarFiltros);
            });

          </script>



</body>

</html>