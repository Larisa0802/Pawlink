<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PawZone — Pre-sala</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          keyframes: {
            gradientShift: {
              '0%,100%': { backgroundPosition: '0% 50%' },
              '50%':     { backgroundPosition: '100% 50%' },
            },
            drift1: {
              '0%,100%': { transform: 'translate(0,0) scale(1)' },
              '25%':     { transform: 'translate(30px,-20px) scale(1.05)' },
              '50%':     { transform: 'translate(-15px,10px) scale(0.97)' },
              '75%':     { transform: 'translate(20px,25px) scale(1.03)' },
            },
            drift2: {
              '0%,100%': { transform: 'translate(0,0) scale(1)' },
              '25%':     { transform: 'translate(-30px,20px) scale(0.96)' },
              '50%':     { transform: 'translate(15px,-10px) scale(1.04)' },
              '75%':     { transform: 'translate(-20px,-25px) scale(1.02)' },
            },
            pulseOrb: {
              '0%,100%': { opacity: '.5', transform: 'translate(-50%,-50%) scale(1)' },
              '50%':     { opacity: '.9', transform: 'translate(-50%,-50%) scale(1.1)' },
            },
            floatDot: {
              '0%,100%': { transform: 'translateY(0) rotate(0deg)' },
              '33%':     { transform: 'translateY(-18px) rotate(3deg)' },
              '66%':     { transform: 'translateY(8px) rotate(-2deg)' },
            },
          },
          animation: {
            gradientShift: 'gradientShift 6s ease infinite',
            drift1:        'drift1 9s ease-in-out infinite',
            drift2:        'drift2 11s ease-in-out infinite',
            pulseOrb:      'pulseOrb 5s ease-in-out infinite',
            floatDot:      'floatDot 6s linear infinite',
          },
        },
      },
    }
  </script>
  <style>
    .btn-main {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      background: #E5531C;
    }
    .btn-main:hover {
      transform: scale(1.03);
      box-shadow: 0 8px 24px rgba(229,83,28,0.45);
    }
  </style>
</head>

<body class="min-h-screen flex items-center justify-center overflow-hidden relative font-[DM_Sans]">

  <!-- Fondo animado -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-orange-600 via-orange-300 to-cyan-300 bg-[length:400%_400%] animate-gradientShift"></div>

  <!-- Card principal -->
  <div class="flex flex-col items-center px-8 w-full max-w-sm">

    <p class="text-white/70 text-xs tracking-[0.25em] uppercase mb-2">Bienvenido a</p>
    <h1 class="text-white text-5xl font-bold tracking-tight mb-10">PAWLINK</h1>

    <a href="/login">
      <img
        src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/logo.png"
        class="w-64 mx-auto drop-shadow-xl">
    </a>

    <a href="login" class="w-full mt-16">
      <button class="btn-main w-full text-white text-sm font-semibold py-4 rounded-2xl tracking-wide flex items-center justify-center gap-2">
        Entrar <span class="text-xl">→</span>
      </button>
    </a>

  </div>

  <script>
    const container = document.getElementById('particles');
    for (let i = 0; i < 18; i++) {
      const d = document.createElement('div');
      const size = 3 + Math.random() * 5;
      d.className = 'absolute rounded-full bg-white';
      d.style.cssText = `
        left:${Math.random()*95}%; top:${Math.random()*95}%;
        width:${size}px; height:${size}px;
        opacity:${0.2 + Math.random()*0.5};
        animation: floatDot ${5 + Math.random()*8}s linear ${-Math.random()*8}s infinite;
      `;
      container.appendChild(d);
    }
  </script>

</body>
</html>