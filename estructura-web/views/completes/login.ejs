  <!--LOGICA DEL LOGIN-->
  <script>
    //Cambio entre iniciar sesión y registro
    function switchTab(tab) {
      const isLogin = tab === 'login'; //Aparece siempre primero login
      const vLogin = document.getElementById('viewLogin');
      const vReg = document.getElementById('viewRegister');
      const tLogin = document.getElementById('tabLogin');
      const tReg = document.getElementById('tabRegister');

      vLogin.classList.toggle('hidden', !isLogin);
      vReg.classList.toggle('hidden', isLogin);


      const active = isLogin ? vLogin : vReg; //Detecta cual esta activo
      active.classList.remove('slide-in');
      void active.offsetWidth; //Propiedad de solo lectura que obliga al navegador a calcular el layout de active
      active.classList.add('slide-in');

      //Si el tab esta en login lo asigna la clase activo sino como inactivo + el resto de clases
      tLogin.className = (isLogin ? 'tab-active' : 'tab-inactive') + ' pb-2 text-sm font-semibold tracking-wide transition-all';
      tReg.className = (!isLogin ? 'tab-active' : 'tab-inactive') + ' pb-2 text-sm font-semibold tracking-wide transition-all';
    }

    //Cambio mascota
    function setMascot(type) {
      const btnCat = document.getElementById("btnCat");
      const btnDog = document.getElementById("btnDog");
      const tagline = document.getElementById("tagline");
      const especieInput = document.getElementById("especieInput");
      const catImg = document.getElementById("svgCat");
      const dogImg = document.getElementById("svgDog");

      //Si el tipo es gato, se muestra la imagen de gato y se oculta la de perro, si es perro viceversa.
      if (type === "cat") {
        btnCat.style.background = "#E5531C";
        btnCat.style.color = "#000";
        btnDog.style.background = "transparent";
        btnDog.style.color = "rgba(0,0,0,0.4)";
        tagline.innerHTML = `"Los gatos no necesitan motivo<br>para quererte."`;
        especieInput.value = "cat";

        catImg.style.display = "block";
        dogImg.style.display = "none";
      } else {
        btnDog.style.background = "#E5531C";
        btnDog.style.color = "#000";
        btnCat.style.background = "transparent";
        btnCat.style.color = "rgba(0,0,0,0.4)";
        tagline.innerHTML = `"Los perros llenan tu vida<br>de amor y lealtad."`;
        especieInput.value = "dog";

        dogImg.style.display = "block";
        catImg.style.display = "none";
      }
    }


    //Función lógica del ojo
    function togglePassword(inputId, openId, closedId) {
      const input = document.getElementById(inputId);
      const open = document.getElementById(openId);
      const closed = document.getElementById(closedId);
      const isPass = input.type === 'password';
      //Si el input de la contraseña es de tipo contraseña se cambia a texto y viceversa.
      input.type = isPass ? 'text' : 'password';
      open.style.display = isPass ? 'none' : 'block';
      closed.style.display = isPass ? 'block' : 'none';
    }

    //Mostrar el tab correcto al cargar si hay error en registro
    document.addEventListener('DOMContentLoaded', () => {

      const activeTab = '<%= activeTab || "login" %>';
      if (activeTab === 'register') {
        switchTab('register');
      }
    });

    //Logica para modal de políticas
    function showPolicy(type) {
      const isPrivacidad = (type === 'privacidad');

      document.getElementById('privacidad').style.display = isPrivacidad ? 'block' : 'none';
      document.getElementById('cookies').style.display = isPrivacidad ? 'none' : 'block';
    }

    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove('hidden');
        showPolicy('privacidad');
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('hidden');
      }
    }

  </script>
