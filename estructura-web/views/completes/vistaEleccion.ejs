<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Pawlink</title>
    <style>
        #editModal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            /* Fondo oscuro */
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
        }
    </style>

</head>

<body class="min-h-screen">
    <%- include("../partials/sidebar") %>
        <main class="ml-64 p-8 flex-grow bg-[#DDECF6] min-h-screen">
            <% if(userData) { %>
                <nav class="text-sm font-semibold text-gray-400 mb-2">
                    <span id="breadcrumb">Cargando ruta...</span>
                </nav>

                <div class="bg-white rounded-2xl shadow-sm p-8 border-l-8 border-[#E5531C] mb-8">
                    <h1 class="text-3xl font-extrabold text-black">
                        Que tipo de compañero buscas? 🐾
                    </h1>
                </div>

                <!-- Botones de elección -->
                <div class="flex gap-8 mb-1 mr-20 mt-4 justify-center w-[1084px] h-[492px]">
                    <button onclick="handleEleccion('perros')" title="Perros"
                        class="px-6 py-3 w-[1200px] border-2 bg-white rounded-[80px] h-[420px] rounded-2xl p-6 shadow-md transform transition hover:-translate-y-2 hover:shadow-xl"><img
                            class="ml-12 size-50"
                            src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/avatar/dog4.png"
                            alt="imgPerro"></button>
                    <button onclick="handleEleccion('ambos')" title="Ambos"
                        class="flex px-6 py-3 w-[1200px] border-2 bg-white rounded-[80px] h-[392px] mt-24 rounded-2xl p-6 shadow-md transform transition hover:-translate-y-2 hover:shadow-xl"><img
                            src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/cat.png"
                            class="size-36 mt-24" alt="imgBoth"><img
                            src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/avatar/dog4.png"
                            class="size-36 mt-24 pr-4" alt="imgBoth"></button>
                    <button onclick="handleEleccion('gatos')" title="Gatos"
                        class="px-6 py-3 w-[1200px] border-2 bg-white rounded-[80px] h-[420px] rounded-2xl p-6 shadow-md transform transition hover:-translate-y-2 hover:shadow-xl"><img
                            src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/cat.png"
                            class="ml-12 size-50" alt="imgGato"></button>
                </div>

                <!-- MODAL ENCUESTA -->
                <div id="modalEncuesta"
                    class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden z-50">
                    <div class="bg-white p-8 rounded-xl shadow-xl w-full max-w-md relative">
                        <button type="button" onclick="saltarEncuesta()"
                            class="absolute top-4 right-4 text-gray-400 hover:text-red-500 font-bold text-3xl leading-none transition">
                            &times;
                        </button>
                        <h2 class="text-2xl font-bold mb-2">¡Ayúdanos a encontrar tu match ideal! 🐾</h2>
                        <p class="text-gray-600 mb-6">Responde estas breves preguntas para que podamos recomendarte a
                            los animales que mejor conectarán contigo.</p>

                        <form action="/encuesta" method="POST" class="flex flex-col gap-4">
                            <!-- Este input oculto guarda si eligió perros, gatos o ambos -->
                            <input type="hidden" id="tipoEleccion" name="tipo" value="">

                            <div>
                                <label class="block font-semibold mb-1">¿Qué tamaño prefieres?</label>
                                <select name="tamano" id="selectTamano"
                                    class="w-full border p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="Indiferente">Me es indiferente</option>
                                    <option id="opcionPequeno" value="Pequeño">Pequeño</option>
                                    <option value="Mediano">Mediano</option>
                                    <option value="Grande">Grande</option>
                                </select>
                            </div>

                            <div>
                                <label class="block font-semibold mb-1">Nivel de energía deseado</label>
                                <select name="nivel_energia"
                                    class="w-full border p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="Indiferente">Me es indiferente</option>
                                    <option value="Bajo">Tranquilo (Paseos cortos)</option>
                                    <option value="Medio">Activo (Juegos diarios)</option>
                                    <option value="Alto">Muy activo (Deporte y correr)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block font-semibold mb-1">Edad preferida</label>
                                <select name="edad"
                                    class="w-full border p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="Indiferente">Me es indiferente</option>
                                    <option value="Adulto">Adulto (1 a 7 años)</option>
                                    <option value="Senior">Senior (> 7 años)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block font-semibold mb-1">Preferencia de sexo</label>
                                <select name="sexo"
                                    class="w-full border p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="Indiferente">Me es indiferente</option>
                                    <option value="Macho">Macho</option>
                                    <option value="Hembra">Hembra</option>
                                </select>
                            </div>

                            <div class="flex justify-end gap-3 mt-6">
                                <button type="submit"
                                    class="w-full px-4 py-3 bg-[#E5531C] text-white font-bold rounded-lg hover:bg-[#ff6b35] transition">
                                    Encontrar a mi compañero
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!--MODAL DE MATCHES -->
                <% if (typeof matches !=='undefined' && matches) { %>
                    <div id="modalMatches" class="fixed inset-0 bg-black/80 flex justify-center items-center z-50">
                        <div class="bg-white p-8 rounded-xl shadow-xl w-full max-w-4xl max-h-[90vh] overflow-y-auto">
                            <div class="flex justify-between items-center mb-6">
                                <div class="bg-white rounded-2xl shadow-sm p-8 border-l-8 border-blue-300 mb-8">
                                    <h2 class="text-3xl font-bold text-black">Estos son tus matches!💖</h2>
                                </div>
                                <a href="/adopciones?tipo=<%=tipoElegido %>"
                                    class="text-gray-500 hover:text-red-500 font-bold text-2xl transition">
                                    &times;
                                </a>
                            </div>

                            <% if (matches.length> 0){ %>
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    <% matches.forEach(animal=> { %>
                                        <div
                                            class="border rounded-lg p-4 shadow-sm hover:shadow-md transition text-center bg-gray-50">
                                            <h3 class="text-xl font-bold text-gray-800 uppercase">
                                                <%= animal.nombre %>
                                            </h3>
                                            <p class="text-gray-600">
                                                <%= animal.raza %> | <%= animal.sexo %>
                                            </p>

                                            <button
                                                class="masInfo1 mt-4 inline-block px-4 py-2 bg-[#E5531C] text-white font-medium rounded hover:bg-[#ff6b35] w-full"
                                                data-nombre="<%= animal.nombre %>" data-chip="<%= animal.chip || '—' %>"
                                                data-especie="<%= animal.especie || '—' %>"
                                                data-raza="<%= animal.raza || '—' %>"
                                                data-sexo="<%= animal.sexo || '—' %>"
                                                data-nacimiento="<%= new Date(animal.fecha_nacimiento).toLocaleDateString('es-ES') || '—' %>"
                                                data-pelaje="<%= animal.pelaje || '—' %>"
                                                data-vacunas="<%= animal.vacunas || '—' %>"
                                                data-esterilizado="<%= animal.esterilizado ? 'Sí' : 'No' %>"
                                                data-desparasitado="<%=animal.desparasitado ? 'Sí' : 'No' %>"
                                                data-foto="<%= animal.foto || '' %>">
                                                Ver Ficha
                                            </button>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <div class="text-center py-10">
                                        <p class="text-xl text-gray-700">Por ahora no tenemos un animal que cumpla el
                                            100% de tus características.</p>
                                        <p class="text-gray-500 mt-2">¡Pero el amor a primera vista no entiende de
                                            filtros!</p>
                                    </div>
                                    <% } %>
                                        <div class="mt-8 text-center border-t pt-6">
                                            <p class="text-sm text-gray-500 mb-3">Si no ves a tu compañero ideal aquí,
                                                hay muchos más esperándote.</p>
                                            <a href="/adopciones?tipo=<%= tipoElegido %>"
                                                class="px-6 py-3 bg-gray-800 text-white font-bold rounded-lg hover:bg-gray-900 transition">
                                                Explorar Catálogo Completo
                                            </a>
                                        </div>
                        </div>
                    </div>
                    <% } %>

                        <!--LÓGICA -->
                        <script>
                            // Leemos si el usuario ya hizo la encuesta
                            const encuestaRealizada = "<%= userData.encuesta_realizada %>" === "true";
                            //const encuestaRealizada = false;  <-- TRUCAJE TEMPORAL: Siempre salta el modal para estilar y control de errores


                            function handleEleccion(tipo) {
                                if (encuestaRealizada) {
                                    window.location.href = `/adopciones?tipo=${tipo}`;
                                } else {
                                    document.getElementById('tipoEleccion').value = tipo;
                                    const opcionPequeno = document.getElementById('opcionPequeno');

                                    if (tipo === "gatos") {
                                        opcionPequeno.hidden = true;

                                        const selectTamano = document.getElementById('selectTamano');
                                        if (selectTamano.value === "Pequeño") {
                                            selectTamano.value = "Indiferente";
                                        }
                                    } else {
                                        opcionPequeno.hidden = false;
                                    }

                                    document.getElementById('modalEncuesta').classList.remove('hidden');
                                }
                            }


                            function saltarEncuesta() {
                                const tipo = document.getElementById('tipoEleccion').value;
                                window.location.href = `/adopciones?tipo=${tipo}`;
                            }


                            document.addEventListener('DOMContentLoaded', () => {
                                const modal = document.getElementById('editModal');

                                // Rellenar y abrir modal con los datos del botón pulsado
                                document.querySelectorAll('.masInfo1').forEach(btn => {
                                    btn.addEventListener('click', () => {
                                        const d = btn.dataset;

                                        document.getElementById('modal-nombre').textContent = d.nombre;
                                        document.getElementById('modal-chip').textContent = d.chip;
                                        document.getElementById('modal-especie').textContent = d.especie;
                                        document.getElementById('modal-raza').textContent = d.raza;
                                        document.getElementById('modal-sexo').textContent = d.sexo;
                                        document.getElementById('modal-nacimiento').textContent = d.nacimiento;
                                        document.getElementById('modal-pelaje').textContent = d.pelaje;
                                        document.getElementById('modal-vacunas').textContent = d.vacunas;
                                        document.getElementById('modal-esterilizado').textContent = d.esterilizado;
                                        document.getElementById('modal-desparasitado').textContent = d.desparasitado;

                                        // Foto opcional
                                        const fotoWrap = document.getElementById('modal-foto-wrap');
                                        const fotoImg = document.getElementById('modal-foto');
                                        if (d.foto) {
                                            fotoImg.src = d.foto;
                                            fotoImg.alt = d.nombre;
                                            fotoWrap.classList.remove('hidden');
                                        } else {
                                            fotoWrap.classList.add('hidden');
                                        }

                                        modal.style.display = 'flex';
                                    });
                                });

                                // Cerrar con el botón ✕
                                document.getElementById('cerrarModal').addEventListener('click', () => {
                                    modal.style.display = 'none';
                                });

                                // Cerrar al hacer clic en el fondo
                                modal.addEventListener('click', (e) => {
                                    if (e.target === modal) modal.style.display = 'none';
                                });
                            });


                        </script>



                        <% } %>
                            <!-- Modal info animal -->
                            <div id="editModal" style="display: none;">
                                <div
                                    class="relative bg-white rounded-3xl shadow-2xl flex flex-row w-[90%] max-w-5xl overflow-hidden min-h-[450px]">
                                    <div id="modal-foto-wrap"
                                        class="w-1/3 bg-gray-100 flex items-center justify-center overflow-hidden border-r border-gray-100">
                                        <img id="modal-foto" src="" alt="" class="w-full h-full object-cover">
                                    </div>

                                    <div class="flex-1 p-10 flex flex-col justify-center">
                                        <h2 id="modal-nombre"
                                            class="text-4xl font-extrabold text-gray-800 mb-8 pb-2 inline-block"></h2>

                                        <div class="grid grid-cols-2 gap-x-8 gap-y-5 text-gray-700">
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Chip</span><span
                                                    id="modal-chip" class="text-lg font-semibold text-gray-800"></span>
                                            </div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Especie</span><span
                                                    id="modal-especie"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Raza</span><span
                                                    id="modal-raza" class="text-lg font-semibold text-gray-800"></span>
                                            </div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Sexo</span><span
                                                    id="modal-sexo" class="text-lg font-semibold text-gray-800"></span>
                                            </div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Nacimiento</span><span
                                                    id="modal-nacimiento"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Pelaje</span><span
                                                    id="modal-pelaje"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Vacunas</span><span
                                                    id="modal-vacunas"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Esterilizado</span><span
                                                    id="modal-esterilizado"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                            <div><span
                                                    class="text-[10px] uppercase font-bold text-gray-400 block">Desparasitado</span><span
                                                    id="modal-desparasitado"
                                                    class="text-lg font-semibold text-gray-800"></span></div>
                                        </div>
                                    </div>


                                    <div
                                        class="w-48 p-6 flex flex-col justify-between items-end border-l border-gray-50 bg-gray-50/30">
                                        <button id="cerrarModal"
                                            class="text-gray-400 hover:text-gray-600 text-4xl font-light transition-transform hover:scale-110 cursor-pointer">&times;</button>

                                        <div class="flex-1 flex items-center">
                                            <button
                                                class="bg-[#E5531C] text-white font-bold py-4 px-8 rounded-2xl text-sm shadow-lg hover:bg-[#d44819] transition-all hover:-translate-y-1 active:scale-95 whitespace-nowrap">
                                                Adoptar
                                            </button>
                                        </div>
                                        <div class="h-10"></div>
                                    </div>
                                </div>
                            </div>
        </main>
        <%- include("../partials/footer") %>

            <script>
                let pathHistory = JSON.parse(sessionStorage.getItem('userPath')) || [];
                const rutaActual = window.location.pathname + window.location.search;
                if (pathHistory.length === 0 || pathHistory[pathHistory.length - 1] !== rutaActual) {
                    pathHistory.push(rutaActual);
                    sessionStorage.setItem('userPath', JSON.stringify(pathHistory));
                }
                const displayPath = pathHistory.map(ruta => {
                    if (ruta === '/' || ruta.includes('index')) return '🏠 Inicio';
                    if (ruta.includes('vistaEleccion')) return 'Elección';
                    if (ruta.includes('adopciones')) return 'Catálogo';
                    return ruta.replace('/', '');
                }).join('  /  ');
                document.getElementById('breadcrumb').innerText = displayPath;
            </script>
</body>

</html>