<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Mi perfil</title>
    <style>
        #banner,
        #bloqueFantasma {
            display: none;
        }
    </style>
</head>

<body>
    <%if(userData) { %>

        <%- include("../partials/sidebar") %>

            <main class="ml-64 p-6">


                <!-- HEADER FRIENDLY -->
                <section class="bg-[#CCE2ED] rounded-2xl p-8 shadow mb-10 flex flex-col items-center ">

                    <% let
                        img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/default.png"
                        ; if (userData.animal==="cat" ) {
                        img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/cat.png"
                        ; } else if (userData.animal==="dog" ) {
                        img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/dog.png"
                        ; } %>

                        <img id="profileAvatar" src="<%= userData.avatar_url || img %>"
                            class="w-32 h-32 rounded-full object-cover border-4 border-[#E5531C] shadow mb-4">

                        <h1 class="text-3xl font-bold text-black">Hola, <%= userData.nombre %> 🐾</h1>
                        <p class="text-gray-700">
                            <%= userData.email %>
                        </p>

                        <p class="text-gray-600 text-sm mt-1">
                            Registrado el
                            <%= new Date(userData.fecha).toLocaleDateString("es-ES") %> a las
                                <%= new Date(userData.fecha).toLocaleTimeString("es-ES", { hour: "2-digit" ,
                                    minute: "2-digit" }) %>
                        </p>

                        <button onclick="openModal('modalNombre')"
                            class="mt-4 px-6 py-2 bg-[#E5531C] text-white rounded-full hover:opacity-90 transition font-medium">
                            Editar nombre
                        </button>

                        <button onclick="openModal('modalAvatar')"
                            class="mt-2 px-6 py-2 bg-[#E5531C] text-white rounded-full hover:opacity-90 transition font-medium">
                            Cambiar avatar
                        </button>

                </section>


                <!-- TARJETA DE INFO -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">

                    <div class="bg-white border border-[#DDCCE6] rounded-2xl p-6 shadow">

                        <h2 class="text-xl font-semibold text-black mb-4">Información personal</h2>

                        <!-- GRID INTERNO: TEXTO IZQ + IMAGEN DER -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">

                            <!-- IZQUIERDA: INFO -->
                            <div class="flex flex-col gap-4 text-gray-800">

                                <div class="flex items-center gap-3">
                                    <span class="text-[#E5531C] text-xl">👤</span>
                                    <p><span class="font-semibold">Nombre:</span>
                                        <%= userData.nombre %>
                                    </p>
                                </div>

                                <div class="flex items-center gap-3">
                                    <span class="text-[#E5531C] text-xl">📧</span>
                                    <p><span class="font-semibold">Email:</span>
                                        <%= userData.email %>
                                    </p>
                                </div>

                                <div class="flex items-center gap-3">
                                    <span class="text-[#E5531C] text-xl">📅</span>
                                    <p>
                                        <span class="font-semibold">Fecha de registro:</span>
                                        <%= new Date(userData.fecha).toLocaleDateString("es-ES") %>
                                            <%= new Date(userData.fecha).toLocaleTimeString("es-ES", { hour: "2-digit" ,
                                                minute: "2-digit" }) %>
                                    </p>
                                </div>

                            </div>

                            <!-- DERECHA: IMAGEN -->
                            <div class="flex justify-center">
                                <img src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/info_personal.png"
                                    class="w-40 h-40 object-cover ">
                            </div>

                        </div>

                    </div>

                    <!-- ACCIONES  -->
                    <div class="bg-white border border-[#DDCCE6] rounded-2xl p-6 shadow">

                        <div class="flex justify-between mt-[70px] gap-4">


                            <button onclick="openModal('modalPass')"
                                class="px-5 py-3 bg-[#E5531C] text-white rounded-full hover:opacity-90 transition font-medium  gap-4 w-full text-center">

                                Cambiar <br> contraseña

                            </button>


                            <button onclick="openModal('modalEmail')"
                                class="px-5 py-3 border border-[#E5531C] text-[#E5531C] rounded-full hover:bg-[#E5531C] hover:text-white transition font-medium text-center gap-4 w-full">
                                Cambiar <br> email

                            </button>


                            <!-- Peligro -->
                            <button onclick="openModal('modalDelete')"
                                class="px-5 py-3 bg-red-600 text-white rounded-full hover:bg-red-700 transition text-center gap-4 font-medium w-full">
                                Eliminar cuenta
                            </button>

                        </div>
                    </div>

                </section>

                <!-- CERRAR SESIÓN -->
                <div class="text-center">
                    <button onclick="openModal('modalLogout')"
                        class="px-6 py-3 bg-gray-300 text-black rounded-full hover:bg-gray-400 transition font-medium">
                        Cerrar sesión
                    </button>
                </div>

                <% } else { %>

                    <h1>No estás logueado</h1>

                    <% } %>

            </main>

            <!--MODALES DE PERFIL-->
            <div id="modalDelete"
                class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white p-6 rounded-xl shadow-xl w-96">
                    <h2 class="text-xl font-bold mb-4">¿Estas segur@ de eliminar tu
                        cuenta?</h2>
                    <p class="text-gray-700 mb-6">No podrás recuperar tu cuenta
                        después de eliminar la cuenta</p>

                    <div class="flex gap-3">

                        <form action="/usuarios/delete" method="POST">

                            <div class="justify-center">
                                <label class="block">Introduce tu
                                    contraseña</label>
                                <input
                                    class="w-full p-3 rounded-lg bg-white/30 placeholder-white/70 focus:outline-none border"
                                    type="password" name="password">

                                <% if(errorD){ %>
                                    <h3 id="error" style="color: red;">
                                        <%= errorD.mensaje %>
                                    </h3>
                                    <% } %>
                            </div> <br>

                            <div class="justify-end">
                                <button type="submit"
                                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Eliminar
                                    cuenta</button>

                                <button type="button" onclick="closeModal('modalDelete')"
                                    class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    </div>

                </div>

            </div>

            <div id="modalPass"
                class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white p-6 rounded-xl shadow-xl w-96">
                    <h2 class="text-xl font-bold mb-4">Cambio de contraseña</h2>
                    <p class="text-gray-700 mb-6">Tendras que volver a iniciar
                        sesión una vez cambiada</p>

                    <div class="flex gap-3">

                        <form action="/usuarios/password" method="post">
                            <label class="block">Introduce tu contraseña
                                actual</label>
                            <input type="password" name="oldPass" placeholder="Contraseña actual"
                                class="w-full p-3 rounded-lg bg-white/30  focus:outline-none border">
                            <label class="block">Introduce tu nueva
                                contraseña</label>
                            <input type="password" name="newPass" placeholder="Contraseña nueva"
                                class="w-full p-3 rounded-lg bg-white/30 focus:outline-none border"><br><br>
                            <% if(errorP){ %>
                                <h3 id="error" style="color: red;">
                                    <%= errorP.mensaje %>
                                </h3>
                                <% } %>
                                    <button type="submit"
                                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Actualizar
                                        contraseña</button>
                                    <button type="button" onclick="closeModal('modalPass')"
                                        class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">
                                        Cancelar
                                    </button>
                        </form>
                    </div>

                </div>
            </div>

            <div id="modalEmail"
                class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white p-6 rounded-xl shadow-xl w-96">
                    <h2 class="text-xl font-bold mb-4">Cambio de email</h2>
                    <p class="text-gray-700 mb-6">Una vez pulsado el botón, se
                        enviará un email a tu bandeja de entrada, si no lo
                        encuentras, busca en spam</p>

                    <div class="flex gap-3">
                        <form action="/usuarios/email" method="post">
                            <label class="block">Introduce el nuevo email</label>
                            <input type="text" name="email" placeholder="Nuevo email"
                                class="w-full p-3 rounded-lg bg-white/30 focus:outline-none border">
                            <label class="block">Introduce tu contraseña
                                actual</label>
                            <input type="password" name="pass" placeholder="Contraseña actual"
                                class="w-full p-3 rounded-lg bg-white/30 focus:outline-none border"><br><br>
                            <% if(errorE){ %>
                                <h3 id="error" style="color: red;">
                                    <%= errorE.mensaje %>
                                </h3>
                                <% } %>
                                    <button type="submit"
                                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Actualizar</button>
                                    <button type="button" onclick="closeModal('modalEmail')"
                                        class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">
                                        Cancelar
                                    </button>
                        </form>
                    </div>

                </div>
            </div>

            <div id="modalNombre"
                class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white p-6 rounded-xl shadow-xl w-96">
                    <h2 class="text-xl font-bold mb-4">Cambio de nombre</h2>

                    <div class="flex gap-3">
                        <form action="/usuarios/nombre" method="post">
                            <input type="text" name="name" placeholder="Nuevo nombre"
                                class="w-full p-3 rounded-lg bg-white/30 focus:outline-none border">
                            <br><br>

                            <% if(errorN){ %>
                                <h3 id="error" style="color: red;">
                                    <%= errorN.mensaje %>
                                </h3>
                                <% } %>

                                    <% if(mensaje) { %>
                                        <h3 id="mensaje" style="color:green">
                                            <%= mensaje %>
                                        </h3>
                                        <%}%>
                                            <button type="submit"
                                                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Actualizar</button>
                                            <button type="button" onclick="closeModal('modalNombre')"
                                                class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">
                                                Cancelar
                                            </button>
                        </form>

                    </div>

                </div>
            </div>

            <div id="modalLogout"
                class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white p-6 rounded-xl shadow-xl w-96">
                    <h2 class="text-xl font-bold mb-4">¿Deseas cerrar sesión?</h2>

                    <div class="flex gap-3">
                        <form action="/signOutUser" method="post">

                            <button type="submit"
                                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Cerrar
                                sesión</button>
                            <button type="button" onclick="closeModal('modalLogout')"
                                class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">
                                Cancelar
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- MODAL AVATARES -->
            <div id="modalAvatar" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center hidden">
                <div class="bg-white rounded-2xl p-6 w-[90%] max-w-lg shadow-xl">

                    <h2 class="text-xl font-bold text-center mb-4">Elige tu avatar</h2>

                    <div id="avatarGrid" class="grid grid-cols-5 gap-4 max-h-80 overflow-y-auto">
                    </div>

                    <button onclick="closeModal('modalAvatar')"
                        class="mt-6 w-full py-2 bg-gray-300 rounded-full hover:bg-gray-400 transition">
                        Cerrar
                    </button>

                </div>
            </div>


            <script>

                //F(x) para cargar avatares 
                async function loadAvatars() {
                    const grid = document.getElementById("avatarGrid");
                    grid.innerHTML = "<p class='text-center col-span-3'>Cargando...</p>";

                    try {
                        const res = await fetch("http://localhost:3001/avatars");
                        const data = await res.json();

                        grid.innerHTML = "";

                        data.avatars.forEach(a => {
                            const div = document.createElement("div");
                            div.className = "cursor-pointer";

                            div.innerHTML = `
                            <img src="${a.url}" 
                                class="w-full h-24 object-cover rounded-xl border-2 border-transparent hover:border-[#E5531C] transition"
                                onclick="selectAvatar('${a.url}')">
                        `;

                            grid.appendChild(div);
                        });

                    } catch (err) {
                        grid.innerHTML = "<p class='text-red-500 col-span-3'>Error cargando avatares</p>";
                    }
                }

                //F(x) de seleccion de avatares (update)
                async function selectAvatar(url) {
                    const userId = "<%= userData.id %>";

                    const res = await fetch("http://localhost:3000/avatar", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ avatar_url: url })
                    });

                    if (res.ok) {
                        //Actualizar avatar en pantalla
                        document.querySelector("#profileAvatar").src = url;

                        closeModal("modalAvatar");
                    } else {
                        alert("Error al actualizar avatar");
                    }
                }


                function openModal(modal) {
                    document.getElementById(modal).classList.remove("hidden");
                    sessionStorage.setItem("modalAbierto", modal);

                    switch (modal) {
                        case "modalDelete": document.getElementById(modal).classList.remove("hidden"); break;
                        case "modalPass": document.getElementById(modal).classList.remove("hidden"); break;
                        case "modalEmail": document.getElementById(modal).classList.remove("hidden"); break;
                        case "modalNombre": document.getElementById(modal).classList.remove("hidden"); break;
                        case "modalLogout": document.getElementById(modal).classList.remove("hidden"); break;
                        case "modalAvatar": document.getElementById("modalAvatar").classList.remove("hidden");
                            loadAvatars(); break;
                    }

                }

                function closeModal(modal) {
                    document.getElementById(modal).classList.add("hidden");
                    // limpiar mensajes previos
                    const msg = document.getElementById("mensaje");
                    const err = document.getElementById("error");

                    if (msg) msg.remove();
                    if (err) err.remove();
                    sessionStorage.removeItem("modalAbierto");
                    switch (modal) {
                        case "modalDelete": document.getElementById(modal).classList.add("hidden"); break;
                        case "modalPass": document.getElementById(modal).classList.add("hidden"); break;
                        case "modalEmail": document.getElementById(modal).classList.add("hidden"); break;
                        case "modalNombre": document.getElementById(modal).classList.add("hidden"); break;
                        case "modalLogout": document.getElementById(modal).classList.add("hidden"); break;
                        case "modalAvatar": document.getElementById("modalAvatar").classList.add("hidden"); break;

                    }
                }


            </script>

            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const tieneError = document.getElementById("error");
                    const modal = sessionStorage.getItem("modalAbierto");

                    if (modal && tieneError) {
                        openModal(modal);
                    }
                    sessionStorage.removeItem("modalAbierto");
                })
            </script>

            <%- include("../partials/footer") %>


</body>

</html>