<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <%if(userData) { %>
        <%if(userData.admin) { %>
            <%- include("../partials/sidebar") %>

                <main class="md:ml-64 pt-16 md:pt-6 p-6">

                    <nav class="bg-white px-6 py-4 flex gap-12 text-gray-700 text-lg justify-center font-bold relative">
                        <!-- Indicador deslizante (Activo) con el azul de las tablas -->
                        <div id="nav-indicator"
                            class="absolute bottom-0 h-1 bg-[#DDECF6] transition-all duration-300 rounded-full"></div>

                        <a href="#" onclick="mostrarSeccion('usuarios', this)"
                            class="relative group py-2 hover:text-[#E5531C] transition-colors">
                            <span>Usuarios</span>
                            <!-- Subrayado hover con el azul de las tablas -->
                            <span
                                class="absolute bottom-0 left-0 w-full h-1 bg-[#DDECF6]/60 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
                        </a>
                        <a href="#" onclick="mostrarSeccion('animales', this)"
                            class="relative group py-2 hover:text-[#E5531C] transition-colors">
                            <span>Animales</span>
                            <span
                                class="absolute bottom-0 left-0 w-full h-1 bg-[#DDECF6]/60 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
                        </a>
                        <a href="#" onclick="mostrarSeccion('procesos', this)"
                            class="relative group py-2 hover:text-[#E5531C] transition-colors">
                            <span>Procesos</span>
                            <span
                                class="absolute bottom-0 left-0 w-full h-1 bg-[#DDECF6]/60 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
                        </a>
                        <a href="#" onclick="mostrarSeccion('protectoras', this)"
                            class="relative group py-2 hover:text-[#E5531C] transition-colors">
                            <span>Protectoras</span>
                            <span
                                class="absolute bottom-0 left-0 w-full h-1 bg-[#DDECF6]/60 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
                        </a>
                    </nav>

                    <br>
                    <div id="seccion-usuarios" class="overflow-x-auto">
                        <table class="border border-gray-300 rounded-lg border-separate border-spacing-0 w-full"
                            id="usuarios">
                            <tr>
                                <th colspan="5" class="text-center rounded text-white py-2 bg-black">
                                    GESTIÓN DE USUARIOS
                                </th>
                            </tr>
                            <tr class="bg-[#DDECF6]">
                                <th class="border">ID</th>
                                <th class="border">Usuario</th>
                                <th class="border">Email</th>
                                <th class="border">Fecha de registro</th>
                                <th class="border">Acciones</th>
                            </tr>
                            <tbody class="text-center" id="tbody-usuarios">
                                <% if(usuarios && usuarios.length> 0) { %>
                                    <% usuarios.forEach(usuario=> { %>
                                        <tr class="p-20" data-fila>
                                            <td class="border">
                                                <%= usuario.id %>
                                            </td>
                                            <td class="border">
                                                <%= usuario.username %>
                                            </td>
                                            <td class="border">
                                                <%= usuario.email %>
                                            </td>
                                            <td class="border">
                                                <%= new Date(usuario.fecha_registro).toLocaleDateString("es-ES") %>
                                                    <%= new Date(usuario.fecha_registro).toLocaleTimeString("es-ES", {
                                                        hour: "2-digit" , minute: "2-digit" }) %>
                                            </td>
                                            <td class="border">
                                                <!--Boton eliminar-->
                                                <button type="button" onclick="deleteUser('<%= usuario.id %>')"
                                                    class="text-red-600 hover:text-red-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                    </svg>
                                                </button>

                                                <!--Boton editar-->
                                                <button type="button"
                                                    onclick="openEditModal('<%= usuario.id %>', '<%= usuario.username %>', '<%= usuario.email %>', '<%= usuario.admin %>', '<%= usuario.fecha_registro %>')"
                                                    class="text-blue-600 hover:text-blue-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                                    </svg>

                                                </button>

                                            </td>

                                        </tr>

                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="border">No hay usuarios registrados</td>
                                                </tr>
                                                <% } %>
                                                    <tr>
                                                        <td colspan="5" class="text-center py-2">
                                                            <button onclick="openNewModal()"
                                                                class="w-full max-w-xs mx-auto flex items-center justify-center gap-2
                                               bg-[#E5531C] hover:opacity-90 text-white font-medium py-2 rounded transition">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="1.5"
                                                                    stroke="currentColor" class="w-5 h-5">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                                                </svg>
                                                                Añadir usuario
                                                            </button>
                                                        </td>
                                                    </tr>

                            </tbody>
                        </table>
                        <div id="pag-usuarios" class="px-1"></div>
                    </div>
                    <br>
                    <div id="seccion-animales" class="overflow-x-auto">
                        <!--TABLA ANIMALES-->
                        <table class="border border-gray-300 rounded-lg border-separate border-spacing-0 w-full"
                            id="animales">
                            <tr>
                                <th colspan="15" class="text-center rounded text-white py-2 bg-black">
                                    GESTIÓN DE ANIMALES
                                </th>
                            </tr>
                            <tr class="bg-[#DDECF6]">
                                <th class="border">ID</th>
                                <th class="border">Nombre</th>
                                <th class="border">Chip</th>
                                <th class="border">Especie</th>
                                <th class="border">Raza</th>
                                <th class="border">Sexo</th>
                                <th class="border">Fecha de nacimiento</th>
                                <th class="border">Pelaje</th>
                                <th class="border">Vacunas</th>
                                <th class="border">Esterilizado</th>
                                <th class="border">Desparasitado</th>
                                <th class="border">Tamaño</th>
                                <th class="border">Nivel de energía</th>
                                <th class="border">Disponible</th>
                                <th class="border">Acciones</th>
                            </tr>
                            <tbody class="text-center" id="tbody-animales">
                                <% if(animales && animales.length> 0) { %>
                                    <% animales.forEach(animal=> { %>
                                        <tr class="p-10" data-fila>
                                            <td class="border">
                                                <%= animal._id %>
                                            </td>
                                            <td class="border">
                                                <%= animal._nombre %>
                                            </td>
                                            <td class="border">
                                                <%= animal._chip %>
                                            </td>
                                            <td class="border">
                                                <%= animal._especie %>
                                            </td>
                                            <td class="border">
                                                <%= animal._raza %>
                                            </td>
                                            <td class="border">
                                                <%= animal._sexo %>
                                            </td>
                                            <td class="border">
                                                <%= new Date(animal._fecha_nacimiento).toLocaleDateString("es-ES") %>
                                            </td>
                                            <td class="border">
                                                <%= animal._pelaje %>
                                            </td>
                                            <td class="border ">
                                                <%= animal._vacunas %>
                                            </td>
                                            <td class="border">
                                                <%= animal._esterilizado ? 'Sí' : 'No' %>
                                            </td>
                                            <td class="border">
                                                <%= animal._desparasitado ? 'Sí' : 'No' %>
                                            </td>
                                            <td class="border">
                                                <%= animal._tamano %>
                                            </td>

                                            <td class="border">
                                                <%= animal._nivel_energia %>
                                            </td>
                                            <td class="border">
                                                <%= animal._disponible ? 'Sí' : 'No' %>
                                            </td>
                                            <td class="border">
                                                <!--Boton eliminar-->
                                                <button type="button" onclick="deleteAnimal('<%= animal._id %>')"
                                                    class="text-red-600 hover:text-red-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                    </svg>
                                                </button>

                                                <!--Boton editar-->
                                                <button type="button" onclick="openEditAnimalModal(
                                                        '<%= animal._id %>',
                                                        '<%= animal._nombre %>',
                                                        '<%= animal._chip %>',
                                                        '<%= animal._especie %>',
                                                        '<%= animal._raza %>',
                                                        '<%= animal._sexo %>',
                                                        '<%= animal._fecha_nacimiento %>',
                                                        '<%= animal._pelaje %>',
                                                        '<%= animal._vacunas %>',
                                                        '<%= animal._esterilizado %>',
                                                        '<%= animal._desparasitado %>',
                                                        '<%= animal._tamano %>',
                                                        '<%= animal._nivel_energia %>',
                                                        '<%= animal._disponible %>'
                                                    )" class="text-blue-600 hover:text-blue-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="15" class="border">No hay animales registrados</td>
                                                </tr>
                                                <% } %>
                                                    <tr>
                                                        <td colspan="15" class="text-center py-2">
                                                            <button onclick="openNewAnimalModal()"
                                                                class="w-full max-w-xs mx-auto flex items-center justify-center gap-2
                                               bg-[#E5531C] hover:opacity-90 text-white font-medium py-2 rounded transition">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="1.5"
                                                                    stroke="currentColor" class="w-5 h-5">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                                                </svg>
                                                                Añadir animal
                                                            </button>
                                                        </td>
                                                    </tr>
                            </tbody>
                        </table>
                        <div id="pag-animales" class="px-1"></div>
                    </div>

                    <div id="seccion-protectoras" class="overflow-x-auto">
                        <!--TABLA PROTECTORAS-->
                        <table class="border border-gray-300 rounded-lg border-separate border-spacing-0 w-full"
                            id="protectoras">
                            <tr>
                                <th colspan="14" class="text-center rounded text-white py-2 bg-black">
                                    GESTIÓN DE PROTECTORAS
                                </th>
                            </tr>
                            <tr class="bg-[#DDECF6]">
                                <th class="border">ID</th>
                                <th class="border">Nombre</th>
                                <th class="border">Dirección</th>
                                <th class="border">Teléfono</th>
                                <th class="border">Descripción</th>
                                <th class="border">Email</th>
                                <th class="border">Página Web</th>
                                <th class="border">Acciones</th>

                            </tr>
                            <tbody class="text-center" id="tbody-protectoras">
                                <% if (typeof protectoras !=='undefined' && protectoras.length> 0) { %>
                                    <% protectoras.forEach(prote=> { %>
                                        <tr class="hover:bg-gray-50 transition" data-fila>
                                            <td class="py-3 px-4  border text-left font-medium text-gray-800">
                                                <%= prote.id %>
                                            </td>
                                            <td class="py-3 px-4 border text-left font-medium text-gray-800">
                                                <%= prote.nombre %>
                                            </td>
                                            <td class="py-3 px-4 border text-left text-gray-600">
                                                <%= prote.direccion %>
                                            </td>
                                            <td class="text-center border font-medium text-gray-600 min-w-[120px]">
                                                <%= prote.telefono %>
                                            </td>
                                            <td class="py-3 px-4 border text-left text-gray-600">
                                                <%= prote.descripcion %>
                                            </td>
                                            <td class="py-3 px-4  border text-left text-gray-600">
                                                <%= prote.email%>
                                            </td>

                                            <td class="py-3 px-4 border text-center">
                                                <a target="_blank" href="<%= prote.pagina_web %>"
                                                    class="text-[#E5531C] hover:text-amber-600 transition">
                                                    <i class="fa-solid fa-globe text-xl"></i>
                                                </a>
                                            </td>
                                            <td class="border">
                                                <!--Boton eliminar-->
                                                <button type="button"
                                                    class="text-red-600 hover:text-red-800 btn-delete-protectora"
                                                    data-id="<%= prote.id %>">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                    </svg>
                                                </button>

                                                <!--Boton editar-->
                                                <button type="button"
                                                    class="text-blue-600 hover:text-blue-800 btn-edit-protectora"
                                                    data-id="<%= prote.id %>" data-nombre="<%= prote.nombre %>"
                                                    data-direccion="<%= prote.direccion %>"
                                                    data-telefono="<%= prote.telefono %>"
                                                    data-descripcion="<%= prote.descripcion %>"
                                                    data-email="<%= prote.email %>"
                                                    data-animales="<%= prote.numero_animales_web || 0 %>"
                                                    data-web="<%= prote.pagina_web %>">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                        class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                                    </svg>
                                                </button>

                                            </td>

                                        </tr>
                                        <% }) %>
                                            <% } else{ %>
                                                <tr>
                                                    <td colspan="15" class="border">No hay protectoras registradas</td>
                                                </tr>
                                                <% } %>
                                                    <tr>
                                                        <td colspan="9" class="text-center py-2">
                                                            <button
                                                                onclick="document.getElementById('newProtectoraModal').classList.remove('hidden')"
                                                                class="w-full max-w-xs mx-auto flex items-center justify-center gap-2
                                               bg-[#E5531C] hover:opacity-90 text-white font-medium py-2 rounded transition">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="1.5"
                                                                    stroke="currentColor" class="w-5 h-5">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                                                </svg>
                                                                Añadir protectora
                                                            </button>
                                                        </td>
                                                    </tr>
                            </tbody>

                        </table>
                        <div id="pag-protectoras" class="px-1"></div>
                    </div>

                    <!-- ══ TABLA PROCESOS ══ -->
                    <div id="seccion-procesos" class="overflow-x-auto">
                        <table class="border border-gray-300 rounded-lg border-separate border-spacing-0 w-full"
                            id="procesos">
                            <tr>
                                <th colspan="9" class="text-center rounded text-white py-2 bg-black">
                                    GESTIÓN DE PROCESOS DE ADOPCIÓN
                                </th>
                            </tr>
                            <tr class="bg-[#DDECF6]">
                                <th class="border px-2 py-1">ID</th>
                                <th class="border px-2 py-1">Usuario</th>
                                <th class="border px-2 py-1">Animal</th>
                                <th class="border px-2 py-1">Confirmación</th>
                                <th class="border px-2 py-1">Revisión vet.</th>
                                <th class="border px-2 py-1">Documentación</th>
                                <th class="border px-2 py-1">Preparativos</th>
                                <th class="border px-2 py-1">Firma</th>
                                <th class="border px-2 py-1">Acciones</th>
                            </tr>
                            <tbody class="text-center text-sm" id="tbody-procesos">
                                <% if (procesos && procesos.length> 0) { %>
                                    <% procesos.forEach(p=> { %>
                                        <tr data-fila>
                                            <td class="border px-2 py-1">
                                                <%= p.id %>
                                            </td>
                                            <td class="border px-2 py-1 text-left">
                                                <% if (p.animal && p.animal.usuario_nombre) { %>
                                                    <span class="font-medium">
                                                        <%= p.animal.usuario_nombre %>
                                                    </span><br>
                                                    <% } %>
                                                        <span class="text-gray-400 text-xs">
                                                            <%= p.usuario_id.slice(0,8) %>…
                                                        </span>
                                            </td>
                                            <td class="border px-2 py-1">
                                                <% if (p.animal) { %>
                                                    <span class="font-medium">
                                                        <%= p.animal.nombre %>
                                                    </span>
                                                    <span class="text-gray-400 text-xs block">
                                                        <%= p.animal.raza %>
                                                    </span>
                                                    <% } else { %>—<% } %>
                                            </td>
                                            <%
                                                ['confirmacion','revision','preparacion','preparativo','firma'].forEach(field=>
                                                { %>

                                                <% const btnClass=p[field] ? 'bg-[#E5531C] border-[#E5531C] text-white'
                                                    : 'border-gray-300 text-transparent hover:border-[#E5531C]' ; %>
                                                    <td class="border px-2 py-2">
                                                        <button
                                                            onclick="toggleProceso('<%= p.id %>' , '<%= field %>', this)"
                                                            class="w-7 h-7 rounded-full border-2 flex items-center justify-center mx-auto transition
                                                   <%= p[field] ? 'bg-[#E5531C] border-[#E5531C] text-white' : 'border-gray-300 text-transparent hover:border-[#E5531C]' %>">
                                                            <i class="fa-solid fa-check text-xs"></i>
                                                        </button>
                                                    </td>
                                                    <% }); %>
                                                        <td class="border px-2 py-1">
                                                            <button type="button" onclick="deleteProceso('<%= p.id %>')"
                                                                class="text-red-600 hover:text-red-800">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="1.5"
                                                                    stroke="currentColor" class="size-6">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
