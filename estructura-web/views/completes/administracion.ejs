                <script>
                    // ------------- GESTION DE USUARIOS -------------
                    //Borrar usuarios (DELETE)
                    async function deleteUser(id) {
                        if (!confirm("¿Seguro que quieres eliminar este usuario?")) {
                            return;
                        }

                        const res = await fetch(`/adm/users/${id}`, {
                            method: "DELETE"
                        });

                        const data = await res.json();

                        //Si devuelve 200
                        if (data.ok) {
                            alert("Usuario eliminado correctamente");
                            location.reload();
                        } else {
                            alert("Error al eliminar usuario");
                        }
                    }

                    //Funcion para abrir modal de edicion de usuarios
                    function openEditModal(id, name, email, admin, fecha) {
                        document.getElementById("editId").value = id;
                        document.getElementById("editUName").value = name;
                        document.getElementById("editUEmail").value = email;
                        document.getElementById("editUAdmin").value = admin;
                        document.getElementById("editUFecha").value = fecha;

                        document.getElementById("editUserModal").classList.remove("hidden");

                    }

                    function openNewModal() {
                        // Establecer la fecha actual
                        const now = new Date();
                        const fechaFormato = now.toLocaleDateString("es-ES") + " " +
                            now.toLocaleTimeString("es-ES", {
                                hour: "2-digit",
                                minute: "2-digit"
                            });
                        document.getElementById("newFecha").value = fechaFormato;
                        document.getElementById("newUserModal").classList.remove("hidden");

                    }

                    function closeNewModal() {
                        document.getElementById("newUserModal").classList.add("hidden");
                        document.getElementById("newForm").reset();
                    }

                    //Cerrar modal de edicion
                    function closeEditModal(modal) {
                        document.getElementById(modal).classList.add("hidden");

                        switch (modal) {
                            case "editUserModal":
                                document.getElementById(modal).classList.add("hidden");
                                break;
                            case "editAnimalModal":
                                document.getElementById(modal).classList.add("hidden");
                                break;
                        }
                    }

                    //Actualizar datos (UPDATE)
                    document.getElementById("editUForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const id = document.getElementById("editId").value;
                        const name = document.getElementById("editUName").value;
                        const email = document.getElementById("editUEmail").value;
                        const admin = document.getElementById("editUAdmin").value;

                        if (!name || !email) {
                            alert("El nombre y email son obligatorios");
                            return;
                        }

                        const res = await fetch(`/adm/users/${id}`, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                name,
                                email,
                                admin
                            })
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Usuario actualizado correctamente");
                            location.reload();
                        } else {
                            alert("Error al actualizar usuario: " + (data.message || ""));
                        }
                    });

                    //Crear nuevo usuario (CREATE )
                    document.getElementById("newForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const name = document.getElementById("newName").value;
                        const email = document.getElementById("newEmail").value;
                        const password = document.getElementById("newPassword").value;
                        const admin = document.getElementById("newAdmin").value;

                        if (!name || !email || !password) {
                            alert("Por favor rellena todos los campos");
                            return;
                        }

                        const res = await fetch(`/adm/users`, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                name,
                                email,
                                password,
                                admin
                            })
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Usuario creado correctamente");
                            closeNewModal();
                            location.reload();
                        } else {
                            alert("Error al crear usuario: " + (data.message || ""));
                        }
                    });
                    // ── PROCESOS ──
                    async function toggleProceso(id, field, btn) {
                        const res = await fetch(`/adm/procesos/${id}/toggle`, {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ field })
                        });
                        const data = await res.json();
                        if (res.ok) {
                            const isOn = data[field];
                            btn.classList.toggle('bg-[#E5531C]', isOn);
                            btn.classList.toggle('border-[#E5531C]', isOn);
                            btn.classList.toggle('text-white', isOn);
                            btn.classList.toggle('border-gray-300', !isOn);
                            btn.classList.toggle('text-transparent', !isOn);
                        } else {
                            alert(data.error || "Error al actualizar el estado");
                        }
                    }

                    async function deleteProceso(id) {
                        if (!confirm("¿Eliminar este proceso?")) return;
                        const res = await fetch(`/adm/procesos/${id}`, { method: "DELETE" });
                        if ((await res.json()).ok) location.reload();
                        else alert("Error al eliminar");
                    }

                    function openNewProcesoModal() {
                        document.getElementById("newProcesoModal").classList.remove("hidden");
                    }
                    function closeNewProcesoModal() {
                        document.getElementById("newProcesoModal").classList.add("hidden");
                        document.getElementById("newProcesoForm").reset();
                    }

                    document.getElementById("newProcesoForm").addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const usuario_id = document.getElementById("newProcesoUsuario").value;
                        const animal_id = document.getElementById("newProcesoAnimal").value;
                        if (!usuario_id || !animal_id) { alert("Selecciona usuario y animal"); return; }
                        const res = await fetch("/adm/procesos", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ usuario_id, animal_id })
                        });
                        if (res.ok) { closeNewProcesoModal(); location.reload(); }
                        else alert("Error al crear proceso");
                    });

                    // ------------------------ ANIMALES ---------------------

                    //Eliminar animal (DELETE)
                    async function deleteAnimal(id) {
                        if (!confirm("¿Seguro que quieres eliminar este animal?")) {
                            return;
                        }

                        const res = await fetch(`/adm/animales/${id}`, {
                            method: "DELETE"
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Animal eliminado correctamente");
                            location.reload();
                        } else {
                            alert("Error al eliminar animal");
                        }
                    }

                    //Abrir modal animales
                    function openEditAnimalModal(id, nombre, chip, especie, raza, sexo, fecha, pelaje, vacunas, esterilizado, desparasitado, tamano, energia, disponible) {

                        document.getElementById("editAnimalId").value = id;
                        document.getElementById("editAnimalNombre").value = nombre;
                        document.getElementById("editAnimalChip").value = chip;
                        document.getElementById("editAnimalEspecie").value = especie;
                        document.getElementById("editAnimalRaza").value = raza;
                        document.getElementById("editAnimalSexo").value = sexo;
                        document.getElementById("editAnimalFecha").value = new Date(fecha).toISOString().split("T")[0];
                        document.getElementById("editAnimalPelaje").value = pelaje;
                        document.getElementById("editAnimalEnergia").value = energia;
                        document.getElementById("editAnimalVacunas").value = vacunas;
                        document.getElementById("editAnimalEsterilizado").value = esterilizado === "true" ? "true" : "false";
                        document.getElementById("editAnimalDesparasitado").value = desparasitado === "true" ? "true" : "false";
                        document.getElementById("editAnimalDisponible").value = disponible === "true" ? "true" : "false";

                        document.getElementById("editAnimalModal").classList.remove("hidden");
                    }

                    // Abrir modal de nuevo animal
                    function openNewAnimalModal() {
                        document.getElementById("newAnimalModal").classList.remove("hidden");
                    }

                    // Cerrar modal de nuevo animal
                    function closeNewAnimalModal() {
                        document.getElementById("newAnimalModal").classList.add("hidden");
                        document.getElementById("newAnimalForm").reset();
                    }


                    //Actualizar animal (UPDATE)
                    document.getElementById("editAnimalForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const id = document.getElementById("editAnimalId").value;

                        const body = {
                            nombre: document.getElementById("editAnimalNombre").value,
                            chip: document.getElementById("editAnimalChip").value,
                            especie: document.getElementById("editAnimalEspecie").value,
                            raza: document.getElementById("editAnimalRaza").value,
                            sexo: document.getElementById("editAnimalSexo").value,
                            fecha_nacimiento: document.getElementById("editAnimalFecha").value,
                            pelaje: document.getElementById("editAnimalPelaje").value,
                            vacunas: document.getElementById("editAnimalVacunas").value,
                            esterilizado: document.getElementById("editAnimalEsterilizado").value === "true",
                            desparasitado: document.getElementById("editAnimalDesparasitado").value === "true",
                            tamano: document.getElementById("editAnimalTamano").value,
                            nivel_energia: document.getElementById("editAnimalEnergia").value,
                            disponible: document.getElementById("editAnimalDisponible").value === "true"
                        };

                        const res = await fetch(`/adm/animales/${id}`, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify(body)
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Animal actualizado correctamente");
                            closeEditModal("editAnimalModal");
                            location.reload();
                        } else {
                            alert("Error al actualizar animal: " + (data.message || ""));
                        }
                    });


                    //Crear nuevo animal (CREATE)
                    document.getElementById("newAnimalForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const nombre = document.getElementById("newAnimalNombre").value.trim();
                        const especie = document.getElementById("newAnimalEspecie").value;
                        const raza = document.getElementById("newAnimalRaza").value.trim();
                        const sexo = document.getElementById("newAnimalSexo").value;

                        if (!nombre || !raza) {
                            alert("Nombre y raza son obligatorios");
                            return;
                        }

                        const body = {
                            nombre,
                            chip: document.getElementById("newAnimalChip").value.trim() || null,
                            especie,
                            raza,
                            sexo,
                            fecha_nacimiento: document.getElementById("newAnimalFecha").value || null,
                            pelaje: document.getElementById("newAnimalPelaje").value.trim() || null,
                            vacunas: document.getElementById("newAnimalVacunas").value.trim() || null,
                            esterilizado: document.getElementById("newAnimalEsterilizado").value === "true",
                            desparasitado: document.getElementById("newAnimalDesparasitado").value === "true",
                            tamano: document.getElementById("newAnimalTamano").value,
                            nivel_energia: document.getElementById("newAnimalEnergia").value,
                            disponible: document.getElementById("newAnimalDisponible").value === "true",
                            protectora_id: document.getElementById("newAnimalProtectora").value || null
                        };

                        const res = await fetch("/adm/animales", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(body)
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Animal creado correctamente");
                            closeNewAnimalModal();
                            location.reload();
                        } else {
                            alert("Error al crear animal: " + (data.message || ""));
                        }
                    });

                    // -------------------- PROTECTORAS -----------------------------

                    //Abrir modal de editar protectora
                    document.addEventListener("click", (e) => {
                        const btn = e.target.closest(".btn-edit-protectora");
                        if (!btn) return;

                        const d = btn.dataset;
                        document.getElementById("editProtectoraId").value = d.id;
                        document.getElementById("editProtectoraNombre").value = d.nombre;
                        document.getElementById("editProtectoraDireccion").value = d.direccion;
                        document.getElementById("editProtectoraTelefono").value = d.telefono;
                        document.getElementById("editProtectoraDescripcion").value = d.descripcion;
                        document.getElementById("editProtectoraEmail").value = d.email;
                        document.getElementById("editProtectoraAnimales").value = d.animales || 0;
                        document.getElementById("editProtectoraWeb").value = d.web;

                        document.getElementById("editProtectoraModal").classList.remove("hidden");
                    });

                    //Guardar edicion de la protectora seleccionada (UPDATE)
                    document.getElementById("editProtectoraForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const id = document.getElementById("editProtectoraId").value;

                        const body = {
                            nombre: document.getElementById("editProtectoraNombre").value,
                            direccion: document.getElementById("editProtectoraDireccion").value,
                            telefono: document.getElementById("editProtectoraTelefono").value,
                            descripcion: document.getElementById("editProtectoraDescripcion").value,
                            email: document.getElementById("editProtectoraEmail").value,
                            numero_animales_web: document.getElementById("editProtectoraAnimales").value,
                            pagina_web: document.getElementById("editProtectoraWeb").value
                        };

                        const res = await fetch(`http://localhost:3001/api/protectoras/${id}`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(body)
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Protectora actualizada correctamente");
                            closeEditModal("editProtectoraModal");
                            location.reload();
                        } else {
                            alert("Error al actualizar protectora: " + (data.message || ""));
                        }
                    });

                    //Borrar protectora (DELETE)
                    document.addEventListener("click", async (e) => {
                        const btn = e.target.closest(".btn-delete-protectora");
                        if (!btn) return;

                        if (!confirm("¿Seguro que quieres eliminar esta protectora?")) return;

                        const id = btn.dataset.id;

                        const res = await fetch(`http://localhost:3001/api/protectoras/${id}`, {
                            method: "DELETE"
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Protectora eliminada correctamente");
                            location.reload();
                        } else {
                            alert("Error al eliminar protectora: " + (data.message || ""));
                        }
                    });

                    //Cerrar modal de nueva protectora
                    function closeNewProtectoraModal() {
                        document.getElementById("newProtectoraModal").classList.add("hidden");
                        document.getElementById("newProtectoraForm").reset();
                    }

                    //Crear nueva protectora (CREATE)
                    document.getElementById("newProtectoraForm").addEventListener("submit", async (e) => {
                        e.preventDefault();

                        const nombre = document.getElementById("newProtectoraNombre").value;
                        const telefono = document.getElementById("newProtectoraTelefono").value;
                        const direccion = document.getElementById("newProtectoraDireccion").value;
                        const descripcion = document.getElementById("newProtectoraDescripcion").value;
                        const email = document.getElementById("newProtectoraEmail").value;
                        const web = document.getElementById("newProtectoraWeb").value;

                        if (!nombre || !email) {
                            alert("El nombre y el email son obligatorios");
                            return;
                        }

                        const res = await fetch(`http://localhost:3001/api/protectoras`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ nombre, telefono, direccion, descripcion, email, pagina_web: web })
                        });

                        const data = await res.json();

                        if (data.ok) {
                            alert("Protectora creada correctamente");
                            closeNewProtectoraModal();
                        } else {
                            alert("Error al crear protectora: " + (data.message || ""));
                        }
                    });
                    //------------FUNCION PARA RENDERIZAR LAS TABLAS DE MANERA INDEPENDIENTE-------------
                    document.addEventListener("DOMContentLoaded", () => {
                        // Inicializar la sección de usuarios y su indicador
                        const primerTab = document.querySelector('nav a');
                        mostrarSeccion("usuarios", primerTab);
                    });

                    function mostrarSeccion(seccion, linkEl) {
                        const secciones = ["usuarios", "animales", "protectoras", "procesos"];

                        secciones.forEach(s => {
                            const el = document.getElementById("seccion-" + s);
                            if (el) el.classList.add("hidden");
                        });
                        const activa = document.getElementById("seccion-" + seccion);
                        if (activa) activa.classList.remove("hidden");

                        // Marcamos el nav activo y movemos el indicador
                        const indicator = document.getElementById("nav-indicator");

                        document.querySelectorAll("nav a").forEach(a => {
                            a.classList.remove("text-[#E5531C]");
                            a.classList.add("text-gray-700");
                        });

                        if (linkEl && indicator) {
                            linkEl.classList.remove("text-gray-700");
                            linkEl.classList.add("text-[#E5531C]");

                            // Calcular posición y ancho del enlace para el indicador
                            indicator.style.width = `${linkEl.offsetWidth}px`;
                            indicator.style.left = `${linkEl.offsetLeft}px`;
                        }

                        // Inicializar paginación de la sección activa
                        if (paginacion[seccion]) {
                            paginacion[seccion].paginaActual = 1;
                            renderPagina(seccion);
                        }
                    }

                    // ============================================================
                    // SISTEMA DE PAGINACIÓN CLIENT-SIDE
                    // ============================================================

                    const FILAS_POR_PAGINA = 10;

                    // Estado de paginación por tabla
                    const paginacion = {
                        usuarios: { paginaActual: 1, tbodyId: "tbody-usuarios", containerId: "pag-usuarios" },
                        animales: { paginaActual: 1, tbodyId: "tbody-animales", containerId: "pag-animales" },
                        protectoras: { paginaActual: 1, tbodyId: "tbody-protectoras", containerId: "pag-protectoras" },
                        procesos: { paginaActual: 1, tbodyId: "tbody-procesos", containerId: "pag-procesos" },
                    };

                    function renderPagina(seccion) {
                        const config = paginacion[seccion];
                        const tbody = document.getElementById(config.tbodyId);
                        if (!tbody) return;

                        // Todas las filas de datos (excluir la fila del botón "Añadir")
                        const todasLasFilas = Array.from(tbody.querySelectorAll("tr[data-fila]"));
                        const totalFilas = todasLasFilas.length;
                        const totalPaginas = Math.max(1, Math.ceil(totalFilas / FILAS_POR_PAGINA));

                        // Clamp página
                        config.paginaActual = Math.min(config.paginaActual, totalPaginas);
                        const inicio = (config.paginaActual - 1) * FILAS_POR_PAGINA;
                        const fin = inicio + FILAS_POR_PAGINA;

                        // Mostrar/ocultar filas
                        todasLasFilas.forEach((fila, i) => {
                            fila.classList.toggle("hidden", i < inicio || i >= fin);
                        });

                        // Renderizar controles
                        renderControlesPaginacion(seccion, config.paginaActual, totalPaginas, totalFilas);
                    }

                    function renderControlesPaginacion(seccion, paginaActual, totalPaginas, totalFilas) {
                        const container = document.getElementById(paginacion[seccion].containerId);
                        if (!container) return;

                        const inicio = (paginaActual - 1) * FILAS_POR_PAGINA + 1;
                        const fin = Math.min(paginaActual * FILAS_POR_PAGINA, totalFilas);

                        // Botones de página: máximo 5 visibles
                        let botonesHTML = "";
                        const rango = 2;
                        for (let i = 1; i <= totalPaginas; i++) {
                            if (i === 1 || i === totalPaginas || (i >= paginaActual - rango && i <= paginaActual + rango)) {
                                const activo = i === paginaActual
                                    ? "bg-[#E5531C] text-white"
                                    : "bg-white text-gray-700 hover:bg-gray-100";
                                botonesHTML += `<button onclick="irAPagina('${seccion}', ${i})"
                                        class="w-8 h-8 rounded-full text-sm font-medium border transition ${activo}">${i}</button>`;
                            } else if (i === paginaActual - rango - 1 || i === paginaActual + rango + 1) {
                                botonesHTML += `<span class="px-1 text-gray-400">…</span>`;
                            }
                        }

                        container.innerHTML = `
                                <div class="flex items-center justify-between mt-3 px-1">
                                    <span class="text-sm text-gray-500">
                                        Mostrando <strong>${totalFilas > 0 ? inicio : 0}–${fin}</strong> de <strong>${totalFilas}</strong>
                                    </span>
                                    <div class="flex items-center gap-1">
                                        <button onclick="irAPagina('${seccion}', ${paginaActual - 1})"
                                            ${paginaActual === 1 ? "disabled" : ""}
                                            class="w-8 h-8 rounded-full border bg-white text-gray-500 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed transition">
                                            <i class="fa-solid fa-chevron-left text-xs"></i>
                                        </button>
                                        ${botonesHTML}
                                        <button onclick="irAPagina('${seccion}', ${paginaActual + 1})"
                                            ${paginaActual === totalPaginas ? "disabled" : ""}
                                            class="w-8 h-8 rounded-full border bg-white text-gray-500 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed transition">
                                            <i class="fa-solid fa-chevron-right text-xs"></i>
                                        </button>
                                    </div>
                                </div>`;
                    }

                    function irAPagina(seccion, pagina) {
                        const config = paginacion[seccion];
                        const tbody = document.getElementById(config.tbodyId);
                        if (!tbody) return;
                        const totalFilas = tbody.querySelectorAll("tr[data-fila]").length;
                        const totalPaginas = Math.max(1, Math.ceil(totalFilas / FILAS_POR_PAGINA));
                        config.paginaActual = Math.max(1, Math.min(pagina, totalPaginas));
                        renderPagina(seccion);
                    }

                </script>


</body>

</html>