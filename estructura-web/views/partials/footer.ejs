<script>
(function () {
    const btn   = document.getElementById('newsletterBtn');
    const input = document.getElementById('newsletterEmail');
    const msg   = document.getElementById('newsletterMsg');
    if (!btn) return;

    btn.addEventListener('click', async () => {
        const email = input.value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.textContent = 'Enviando...';

        try {
            const res = await fetch('http://localhost:3001/suscribir', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            if (res.ok) {
                msg.textContent = '¡Gracias! Revisa tu bandeja de entrada 🐾';
                msg.className = 'mt-3 text-sm text-green-400';
                input.value = '';
                btn.textContent = '¡Suscrito!';
            } else {
                msg.textContent = 'Algo salió mal. Inténtalo de nuevo.';
                msg.className = 'mt-3 text-sm text-red-400';
                btn.disabled = false;
                btn.textContent = 'Suscribirme';
            }
        } catch {
            msg.textContent = 'Error de conexión. Inténtalo más tarde.';
            msg.className = 'mt-3 text-sm text-red-400';
            btn.disabled = false;
            btn.textContent = 'Suscribirme';
        }

        msg.classList.remove('hidden');
    });
})();
</script>