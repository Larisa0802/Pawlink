<script src="https://cdn.tailwindcss.com"></script>


<aside
    class="w-64 h-screen fixed left-0 top-0 bg-[#000000] text-white flex flex-col p-4 shadow-xl border-r border-gray-900">
    <a href="/index"><img class="size-20 ml-16"
            src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/logo.png"
            alt="logo"></a>

    <nav class="flex flex-col gap-3 mt-16">

        <a href="/index"
            class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'inicio' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
            <img class="size-6 mr-2"
                src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/casa_tab.png"
                alt="iconoCasa">
            Inicio
        </a>

        <a href="/vistaEleccion"
            class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'vistaEleccion' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
            <img class="size-6 mr-2"
                src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/adopciones_tab.png"
                alt="iconoAdopcion">
            Adopciones
        </a>

        <a href="/perfil"
            class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'perfil' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
            <img class="size-6 mr-2"
                src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/perfil_tab.png"
                alt="iconoPerfil">
            Perfil
        </a>

        <a href="/procesos"
            class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'procesos' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
            <img class="size-6 mr-2"
                src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/procesos-tab.png"
                alt="iconoProcesos">
            Procesos
        </a>

        <a href="/contacto"
            class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'contacto' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
            <img class="size-6 mr-2"
                src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/contacto-tab.png"
                alt="iconoContacto">
            Contacto
        </a>

        <%if(userData && userData.admin) {%>
            <a href="/adm"
                class="flex px-3 py-2 rounded-lg transition font-bold
           <%= active === 'administracion' ? 'text-[#E5531C] bg-gray-900 font-semibold' : 'hover:bg-gray-900 text-gray-300' %>">
                <img class="size-6 mr-2"
                    src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/admin.png"
                    alt="iconoAdmin">
                Administración
            </a>

            <%}%>

                <!-- <a href="/logout" class="px-3 py-2 rounded-lg bg-red-600 hover:bg-red-700 transition mt-auto">
                    Cerrar sesión
                </a>-->


    </nav>

    <div class="flex items-center w-full h-16 rounded-xl border border-gray-800 bg-[#111111] mt-auto p-3">
        <a href="/perfil" class="shrink-0" alt="Imagen de perfil" name="Imagen de perfil">
            <% let
                img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/default.png"
                ; if (userData && userData.animal==="cat" ) {
                img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/cat.png"
                ; } else if (userData && userData.animal==="dog" ) {
                img="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/dog.png"
                ; } %>

                <img  src="<%= userData.avatar_url || img %>"
                    class="w-12 h-12 rounded-full object-cover border-4 border-[#E5531C] shadow mb-4 mt-4">
        </a>
        <p class="text-white font-bold text-sm ml-3 truncate flex-grow">
            <%= userData && userData.nombre ? userData.nombre : 'Usuario' %>
        </p>
        <div id="iconosDiv" class="flex flex-col items-center justify-center gap-1 ml-2">
            <a href="/perfil" title="Ir a ajustes">
                <i class="fa-solid fa-gear text-gray-400 hover:text-gray-600 text-lg transition"></i>
            </a>

            <a href="/logout" title="Cerrar sesión" onclick="sessionStorage.removeItem('userPath');">
                <i class="fa-solid fa-right-from-bracket text-red-500 hover:text-red-400 text-lg transition"></i>
            </a>
        </div>

    </div>
</aside>
<!-- BANNER CON PICTURE -->
<header id="banner" class="fixed top-0 left-64 right-0 h-40 z-40 overflow-hidden shadow-lg border-b">

    <picture class="w-full h-full">
        <source media="(min-width: 1200px)"
            srcset="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/banner11.png">
        <source media="(min-width: 768px)"
            srcset="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/banner11.png">
        <source media="(max-width: 767px)"
            srcset="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/banner11.png">

        <img src="https://olasrerbelvymhwpknsu.supabase.co/storage/v1/object/public/animalesPAWLINK/imagenesGeneral/banner11.png"
            alt="Banner de PawLink" class="w-full h-full object-cover object-center">
    </picture>

    <!-- (Opcional) Si en el futuro queremos poner texto encima de la foto oscureciéndola un pelín -->
